{
  "name": "driftfield",
  "version": "0.1.0",
  "description": "A cloud of floating orbs to travel through: a dependency-free navigation component for any ordered, tagged collection.",
  "keywords": ["navigation", "3d", "cloud", "orbs", "graph", "tags", "physics", "carousel", "component", "visualization"],
  "license": "MIT",
  "author": "Sasha (https://github.com/shkuznetsov)",
  "homepage": "https://github.com/shkuznetsov/driftfield#readme",
  "repository": { "type": "git", "url": "git+https://github.com/shkuznetsov/driftfield.git" },
  "bugs": { "url": "https://github.com/shkuznetsov/driftfield/issues" },
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "CHANGELOG.md"],
  "main": "./dist/driftfield.js",
  "module": "./dist/driftfield.js",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/driftfield.iife.js",
  "jsdelivr": "./dist/driftfield.iife.js",
  "exports": {
    ".": { "types": "./dist/types/index.d.ts", "import": "./dist/driftfield.js" },
    "./bubbles": { "types": "./dist/types/overlay/index.d.ts", "import": "./dist/driftfield-bubbles.js" },
    "./iife": "./dist/driftfield.iife.js",
    "./bubbles/iife": "./dist/driftfield-bubbles.iife.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && vite build --mode graph && vite build --mode bubbles && tsc -p tsconfig.json --emitDeclarationOnly --outDir dist/types",
    "dev": "vite build --mode graph --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
